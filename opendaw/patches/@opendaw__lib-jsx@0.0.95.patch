 import { isDefined, Lazy, Notifier, Option } from "@opendaw/lib-std";
+// Flowtu Studio mounts the app under a sub-path (vite `base`, e.g. "/studio/").
+// History entries and route matching must agree on that prefix, so every path
+// crossing the URL boundary is normalized here — the single choke point for
+// the Router, LocalLink and every navigateTo/replaceWith caller.
+const baseUrl = () => {
+    try { return import.meta.env?.BASE_URL ?? "/"; } catch { return "/"; }
+};
+export const withBase = (path) => {
+    const base = baseUrl();
+    if (base === "/" || !path.startsWith("/") || path.startsWith("//")) return path;
+    if (path === base.slice(0, -1) || path.startsWith(base)) return path;
+    return base.endsWith("/") ? base.slice(0, -1) + path : base + path;
+};
 export class RouteLocation {
